pkgname=scry
pkgver=0.1.3
pkgrel=1
pkgdesc='Lightweight STL and 3MF previewer with Omarchy theme support'
arch=('x86_64' 'aarch64')
url='https://github.com/seth-reee/Scry'
license=('MIT')
depends=('qt6-base' 'qt6-wayland' 'libglvnd' 'libzip' 'gcc-libs' 'glibc')
makedepends=('cmake' 'ninja' 'pkgconf')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('9d9a0db9bd1ff870164c853b8ab407f5990caf318aaa7b0a18d74df1bf1fb55a')

build() {
  cmake -S "$srcdir/Scry-$pkgver" -B "$srcdir/build-$pkgver" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/build-$pkgver"
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/build-$pkgver"
}
